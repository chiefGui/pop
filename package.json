{
  "name": "pop",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "bun run --cwd apps/pop-desktop setup",
    "dev": "bun run --cwd apps/pop-desktop dev",
    "dev:web": "bun run --cwd apps/pop-web dev",
    "reset": "node scripts/reset.ts all",
    "db:reset": "node scripts/reset.ts db",
    "store:reset": "node scripts/reset.ts store",
    "build": "bun run --cwd apps/pop-desktop package",
    "build:web": "bun run --cwd apps/pop-web build",
    "make": "bun run --cwd apps/pop-desktop make",
    "typecheck": "tsc --noEmit",
    "check": "vp check && bun run typecheck",
    "format": "vp fmt",
    "test": "vp test run",
    "test:smoke": "node scripts/smoke.ts",
    "test:game": "vp test run packages/pop-engine packages/pop-game packages/pop-game-client apps/pop-web/src/game",
    "typecheck:game": "tsc --project packages/pop-engine/tsconfig.json && tsc --project tsconfig.game.json",
    "benchmark": "bun scripts/benchmark.ts"
  },
  "devDependencies": {
    "@stylexjs/eslint-plugin": "0.19.0",
    "@types/node": "26.4.1",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24.11.0"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": []
}
